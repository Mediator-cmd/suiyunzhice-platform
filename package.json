    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "playwright-core": "^1.55.0"
  }
}
