{
  "name": "maitian-platform",
  "version": "1.0.0",
  "private": true,
  "description": "麦田智翼 · 空地协同精准植保云平台",
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "node server/src/index.js",
